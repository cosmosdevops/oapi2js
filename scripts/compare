#!/usr/bin/env bash
# Run the Python tool and this one (with --python-compat) on the same spec
# and flags, then diff the output directories.
#
#   scripts/compare <spec> [flags...]
#
# Example, the way openshift-json-schema builds a flavour:
#   scripts/compare openapi.json --kubernetes --stand-alone --strict --expanded
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
spec=$1
shift
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

(cd "$root" && go build -o "$work/oapi2js" .)

t0=$(date +%s%N)
"$root/scripts/python-reference" "$spec" "$work/python" "$@" >"$work/python.log"
t1=$(date +%s%N)
"$work/oapi2js" --python-compat -o "$work/go" "$@" "$spec" >"$work/go.log"
t2=$(date +%s%N)

echo "python: $(( (t1 - t0) / 1000000 ))ms, $(find "$work/python" -name '*.json' | wc -l) files"
echo "go:     $(( (t2 - t1) / 1000000 ))ms, $(find "$work/go" -name '*.json' | wc -l) files"
if diff -r "$work/python" "$work/go" >"$work/diff"; then
  echo "output identical"
else
  echo "output differs:"
  head -50 "$work/diff"
  exit 1
fi
